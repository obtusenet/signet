set -e

# dh_installsystemd --no-start adds no stop; a removed package must not keep running.
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
	deb-systemd-invoke stop signet.service > /dev/null || true
fi

#DEBHELPER#

exit 0
